# Non-secret defaults. Do not put passwords or client secrets in this file.
ENTRA_TENANT_ID=b29b0240-e051-4989-8492-cafe1e25f54a
GCP_PROJECT_NUMBER=833485904895
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Filled by `go run . register`. Never commit the generated file.
AZURE_CLIENT_ID=

# Hosted WorkIQ MCP server. Set to off to force Microsoft Graph.
WORKIQ_MCP_URL=https://workiq.svc.cloud.microsoft/mcp

# Optional Teams targets. If empty, the agent uses the acting user's first joined team and channel.
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# Acting user for a run. Must be one of the two approved test users.
ACTING_USER=CharlotteW@Caldova56317036.onmicrosoft.com

# purview-dlp-integration. The gate is on unless PURVIEW_DLP_ENABLED=false.
PURVIEW_DLP_ENABLED=true
PURVIEW_CHECK_OUTPUT=true
PURVIEW_FAIL_MODE=closed
PURVIEW_TIMEOUT_MS=15000
